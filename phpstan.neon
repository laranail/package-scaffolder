includes:
    - phpstan-baseline.neon

parameters:
    level: 5

    paths:
        - src

    # The vendored blueprint template lives under stubs/blueprints/laravel but
    # uses the find-replace placeholder namespace (Some\NamespacePath\Blog) and is
    # never autoloaded — exclude it from static analysis.
    excludePaths:
        - stubs/blueprints

    # Existing issues are captured in phpstan-baseline.neon so CI stays green;
    # new code must be clean at the level above. Regenerate the baseline with:
    #   vendor/bin/phpstan analyse --generate-baseline
    treatPhpDocTypesAsCertain: false

    # A baseline entry that stops matching is not a regression, and failing the
    # build for one turns every upstream PHPStan/Larastan release into a red
    # main. CI resolves dev tools with `composer update`, so each run can infer
    # types slightly differently from the run that generated the baseline —
    # nine getOptions() entries went stale exactly this way. Genuine errors
    # still fail the gate; only "this ignore matched nothing" is silenced.
    #
    # The view-string ignore below needs the same setting for its own reason:
    # only larastan 3.x emits that error, so where an older one resolves the
    # pattern would itself become an unmatched-ignore ERROR.
    reportUnmatchedIgnoredErrors: false

    ignoreErrors:
        # larastan validates a view-string literal against a skeleton app that never
        # boots this package's provider, so a namespace registered at RUNTIME is
        # invisible to it and every `view()` / `View::make()` call reads as an error.
        # The views exist; the suite renders them.
        - '#expects view-string, string given#'

